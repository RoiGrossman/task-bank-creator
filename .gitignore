#gitignore:

# VM
.venv/
venv/
Scripts/
Lib/

# Temporary python files
__pycache__/
*.py[cod]

# System files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Dynamic data and outputs
2-data/processed/
2-data/raw/
1-raw_OSM_exports/
*.pbf

# QGIS project files
*.qgs
*.qgz
*.qgs~


# To make sure 'processed' folder is always in Git (even if it's empty)
!data/processed/.gitkeep

# Use ! to force specific files to backup